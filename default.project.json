{
    "name": "DefaultRobloxProject",
    "tree": {
        "$className": "Datamodel",
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "Modules": {
                "$path": "src/Client"
            },
            "Shared": {
                "$path": "src/Shared"
            },
            "Packages": {
                "$path": "Packages"
            }
        },
        "ServerScriptService": {
            "$className": "ServerScriptService",
            "Modules": {
                "$path": "src/Connections/KnitServer.server.lua"
            }
        },
        "ServerStorage": {
            "$className": "ServerStorage",
            "Modules": {
                "$path": "src/Server"
            },
            "Packages": {
                "$path": "ServerPackages"
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "Modules": {
                    "$path": "src/Connections/KnitClient.client.lua"
                }
            }
        }
    }
}